<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>QuickPods.App</RootNamespace>
    <AssemblyName>QuickPods</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns the process DPI manifest; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\docs\assets\branding\quickpods-icon-v2.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickPods.Contracts\QuickPods.Contracts.csproj" />
    <ProjectReference Include="..\QuickPods.BluetoothWorker\QuickPods.BluetoothWorker.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\QuickPods.Core\QuickPods.Core.csproj" />
    <ProjectReference Include="..\QuickPods.Infrastructure\QuickPods.Infrastructure.csproj" />
    <ProjectReference Include="..\QuickPods.Presentation\QuickPods.Presentation.csproj" />
    <ProjectReference Include="..\QuickPods.TaskbarHost\QuickPods.TaskbarHost.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\QuickPods.TaskbarObserver\QuickPods.TaskbarObserver.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\QuickPods.Windows\QuickPods.Windows.csproj" />
  </ItemGroup>

  <Target Name="CopyTaskbarHostManagedAssembly" AfterTargets="Build">
    <MSBuild Projects="..\QuickPods.TaskbarHost\QuickPods.TaskbarHost.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_TaskbarHostTargetPath" />
    </MSBuild>
    <Copy SourceFiles="@(_TaskbarHostTargetPath)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyTaskbarObserverManagedAssembly" AfterTargets="Build">
    <MSBuild Projects="..\QuickPods.TaskbarObserver\QuickPods.TaskbarObserver.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_TaskbarObserverTargetPath" />
    </MSBuild>
    <Copy SourceFiles="@(_TaskbarObserverTargetPath)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBluetoothWorkerRuntime" AfterTargets="Build">
    <MSBuild Projects="..\QuickPods.BluetoothWorker\QuickPods.BluetoothWorker.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BluetoothWorkerTargetPath" />
    </MSBuild>
    <ItemGroup>
      <_BluetoothWorkerRuntimeFile Include="@(_BluetoothWorkerTargetPath->'%(RootDir)%(Directory)QuickPods.BluetoothWorker.exe')" />
      <_BluetoothWorkerRuntimeFile Include="@(_BluetoothWorkerTargetPath)" />
      <_BluetoothWorkerRuntimeFile Include="@(_BluetoothWorkerTargetPath->'%(RootDir)%(Directory)QuickPods.BluetoothWorker.deps.json')" />
      <_BluetoothWorkerRuntimeFile Include="@(_BluetoothWorkerTargetPath->'%(RootDir)%(Directory)QuickPods.BluetoothWorker.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_BluetoothWorkerRuntimeFile)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
