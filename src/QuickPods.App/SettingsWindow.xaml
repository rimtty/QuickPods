<Window x:Class="QuickPods.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPods 設定"
        Width="470"
        MinWidth="430"
        Height="520"
        MinHeight="470"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="QuickPods 設定" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="表示、操作、起動方法を変更します。" />
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="18"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="タスクバー表示" />
                        <ComboBox x:Name="DisplayModeComboBox"
                                  Grid.Column="1"
                                  AutomationProperties.Name="タスクバー表示モード"
                                  DisplayMemberPath="Text"
                                  SelectedValuePath="Value"
                                  SelectionChanged="OnProductSettingChanged" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="テーマ" />
                        <ComboBox x:Name="ThemeComboBox"
                                  Grid.Column="1"
                                  AutomationProperties.Name="QuickPodsのテーマ"
                                  DisplayMemberPath="Text"
                                  SelectedValuePath="Value"
                                  SelectionChanged="OnProductSettingChanged" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="ホイール刻み" />
                        <ComboBox x:Name="MouseWheelStepComboBox"
                                  Grid.Column="1"
                                  AutomationProperties.Name="音量ホイール変更幅"
                                  DisplayMemberPath="Text"
                                  SelectedValuePath="Value"
                                  SelectionChanged="OnProductSettingChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    Padding="18"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <CheckBox x:Name="SetConnectedDeviceAsDefaultCheckBox"
                              AutomationProperties.Name="接続後に既定の音声デバイスへ設定"
                              Click="OnProductSettingChanged"
                              Content="接続後に既定の音声デバイスへ設定" />
                    <CheckBox x:Name="ConfirmBluetoothDisconnectCheckBox"
                              Margin="0,10,0,0"
                              AutomationProperties.Name="Bluetooth切断前に確認"
                              Click="OnProductSettingChanged"
                              Content="Bluetooth切断前に確認" />
                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              Margin="0,10,0,0"
                              AutomationProperties.Name="Windowsログイン時にQuickPodsを自動起動"
                              Checked="OnStartWithWindowsChanged"
                              Unchecked="OnStartWithWindowsChanged"
                              Content="Windowsログイン時に自動起動" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="6">
                <StackPanel Orientation="Horizontal">
                    <Button AutomationProperties.Name="QuickPodsのログフォルダーを開く"
                            Click="OnOpenLogs"
                            Style="{StaticResource QuickPodsLinkButtonStyle}"
                            Content="ログを開く" />
                    <Button Margin="14,0,0,0"
                            AutomationProperties.Name="QuickPodsの診断情報をクリップボードへコピー"
                            Click="OnCopyDiagnostics"
                            Style="{StaticResource QuickPodsLinkButtonStyle}"
                            Content="診断情報をコピー" />
                </StackPanel>
                <TextBlock x:Name="DiagnosticText"
                           Margin="4,12,4,0"
                           AutomationProperties.LiveSetting="Assertive"
                           Foreground="{DynamicResource ErrorBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="VersionText"
                           Margin="4,10,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
