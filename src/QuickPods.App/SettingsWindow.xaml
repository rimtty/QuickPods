<Window x:Class="QuickPods.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPods 設定"
        Width="720"
        MinWidth="660"
        Height="760"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Yu Gothic UI"
        FontSize="14"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="SettingsRowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="SettingsSupportingTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="13,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ControlSurface"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="8">
                                            <Grid Margin="13,0,10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           Text="{Binding SelectedItem.Text, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Path Grid.Column="1"
                                                      Width="10"
                                                      Height="6"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 1,1 L 5,5 L 9,1"
                                                      Stroke="{DynamicResource SecondaryTextBrush}"
                                                      StrokeLineJoin="Round"
                                                      StrokeThickness="1.5" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ControlSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                <Setter TargetName="ControlSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ControlSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsToggleStyle" TargetType="CheckBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <Border x:Name="SwitchTrack"
                                    Grid.Column="1"
                                    Width="48"
                                    Height="26"
                                    Margin="18,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource TrackBrush}"
                                    BorderBrush="{DynamicResource SecondaryTextBrush}"
                                    BorderThickness="1"
                                    CornerRadius="13">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="20"
                                         Height="20"
                                         Margin="2"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource ToggleThumbBrush}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsOutlinedButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource QuickPodsSecondaryButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.86,0.05"
                                     GradientOrigin="0.86,0.05"
                                     RadiusX="0.72"
                                     RadiusY="0.62">
                    <GradientStop Offset="0" Color="#1426CFE6" />
                    <GradientStop Offset="0.45" Color="#071B8796" />
                    <GradientStop Offset="1" Color="#0011151A" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,20,32,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="28"
                                   FontWeight="SemiBold"
                                   Text="QuickPods 設定" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="表示、操作、起動方法を変更します。" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="24,0,0,3"
                               VerticalAlignment="Bottom"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="変更は自動的に保存されます" />
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="表示" />

                        <Grid Height="50" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="タスクバー表示" />
                                <TextBlock Style="{StaticResource SettingsSupportingTextStyle}" Text="表示方法を選択" />
                            </StackPanel>
                            <ComboBox x:Name="DisplayModeComboBox"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="タスクバー表示モード"
                                      DisplayMemberPath="Text"
                                      SelectedValuePath="Value"
                                      SelectionChanged="OnProductSettingChanged"
                                      Style="{StaticResource SettingsComboBoxStyle}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource PanelBorderBrush}" />

                        <Grid Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="テーマ" />
                                <TextBlock Style="{StaticResource SettingsSupportingTextStyle}" Text="アプリの外観" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeComboBox"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="QuickPodsのテーマ"
                                      DisplayMemberPath="Text"
                                      SelectedValuePath="Value"
                                      SelectionChanged="OnProductSettingChanged"
                                      Style="{StaticResource SettingsComboBoxStyle}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource PanelBorderBrush}" />

                        <Grid Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="音量調整ステップ" />
                                <TextBlock Style="{StaticResource SettingsSupportingTextStyle}" Text="ホイール操作1回あたり" />
                            </StackPanel>
                            <ComboBox x:Name="MouseWheelStepComboBox"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="音量ホイール変更幅"
                                      DisplayMemberPath="Text"
                                      SelectedValuePath="Value"
                                      SelectionChanged="OnProductSettingChanged"
                                      Style="{StaticResource SettingsComboBoxStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="動作" />
                        <CheckBox x:Name="SetConnectedDeviceAsDefaultCheckBox"
                                  Margin="0,4,0,0"
                                  AutomationProperties.Name="接続後に既定の音声デバイスへ設定"
                                  Click="OnProductSettingChanged"
                                  Style="{StaticResource SettingsToggleStyle}"
                                  Content="接続後に既定の音声デバイスへ設定" />
                        <Border Height="1" Background="{DynamicResource PanelBorderBrush}" />
                        <CheckBox x:Name="ConfirmBluetoothDisconnectCheckBox"
                                  AutomationProperties.Name="Bluetooth切断前に確認"
                                  Click="OnProductSettingChanged"
                                  Style="{StaticResource SettingsToggleStyle}"
                                  Content="Bluetooth切断前に確認" />
                        <Border Height="1" Background="{DynamicResource PanelBorderBrush}" />
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  AutomationProperties.Name="Windowsログイン時にQuickPodsを自動起動"
                                  Checked="OnStartWithWindowsChanged"
                                  Unchecked="OnStartWithWindowsChanged"
                                  Style="{StaticResource SettingsToggleStyle}"
                                  Content="Windowsログイン時に自動起動" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="6" Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="サポート" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button AutomationProperties.Name="QuickPodsのログフォルダーを開く"
                                    Click="OnOpenLogs"
                                    Style="{StaticResource SettingsOutlinedButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,9,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="15"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="&#xE8B7;" />
                                    <TextBlock VerticalAlignment="Center" Text="ログを開く" />
                                </StackPanel>
                            </Button>
                            <Button Margin="12,0,0,0"
                                    AutomationProperties.Name="QuickPodsの診断情報をクリップボードへコピー"
                                    Click="OnCopyDiagnostics"
                                    Style="{StaticResource SettingsOutlinedButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,9,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="15"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="&#xE8C8;" />
                                    <TextBlock VerticalAlignment="Center" Text="診断情報をコピー" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="DiagnosticText"
                                   Margin="2,10,2,0"
                                   AutomationProperties.LiveSetting="Assertive"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VersionText"
                               Margin="2,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="ResetSettingsButton"
                                AutomationProperties.Name="QuickPodsの設定を既定値に戻す"
                                Click="OnResetSettings"
                                Content="既定値に戻す"
                                Style="{StaticResource SettingsOutlinedButtonStyle}" />
                        <Button x:Name="RestartApplicationButton"
                                Margin="12,0,0,0"
                                AutomationProperties.Name="QuickPodsを再起動する"
                                Click="OnRestartApplication"
                                Content="再起動"
                                Style="{StaticResource SettingsOutlinedButtonStyle}" />
                        <Button Margin="12,0,0,0"
                                AutomationProperties.Name="QuickPods設定を閉じる"
                                Click="OnCloseWindow"
                                Content="閉じる"
                                Style="{StaticResource SettingsOutlinedButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
