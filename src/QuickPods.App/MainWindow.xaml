<Window x:Class="QuickPods.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPods Audio MVP"
        Width="440"
        Height="310"
        MinWidth="400"
        MinHeight="280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="オーディオ" />
            <TextBlock x:Name="EndpointNameText"
                       Margin="0,8,0,0"
                       FontSize="14"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="既定の出力を確認しています…"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="18"
                CornerRadius="12"
                Background="{StaticResource PanelBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock FontSize="15" FontWeight="SemiBold" Text="音量" />
                <TextBlock x:Name="VolumePercentText"
                           Grid.Column="1"
                           FontSize="15"
                           Text="--%" />

                <Slider x:Name="VolumeSlider"
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Minimum="0"
                        Maximum="100"
                        SmallChange="1"
                        LargeChange="5"
                        IsSnapToTickEnabled="True"
                        ValueChanged="OnVolumeChanged"
                        PreviewMouseLeftButtonUp="OnVolumeCommit" />

                <StackPanel Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                    <Button x:Name="MuteButton"
                            Width="126"
                            Height="36"
                            Click="OnToggleMute"
                            Content="ミュート" />
                    <Button Width="92"
                            Height="36"
                            Margin="10,0,0,0"
                            Click="OnRefresh"
                            Content="再取得" />
                    <TextBlock x:Name="StatusText"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="初期化中" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="DiagnosticText"
                   Grid.Row="4"
                   Foreground="#FFB4A9"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
