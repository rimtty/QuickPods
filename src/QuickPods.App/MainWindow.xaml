<Window x:Class="QuickPods.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPods"
        Width="520"
        MinWidth="440"
        MaxHeight="780"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Loaded="OnLoaded"
        ContentRendered="OnContentRendered"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Closing="OnClosing"
        Closed="OnClosed">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Padding="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource SelectedBrush}" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="オーディオ" />
                    <TextBlock x:Name="EndpointNameText"
                               Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="既定の出力を確認しています…"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Margin="12,0,0,0"
                        AutomationProperties.Name="オーディオとBluetoothデバイスを更新"
                        Click="OnRefresh"
                        Style="{StaticResource QuickPodsIconButtonStyle}">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="20"
                               Text="&#xE72C;" />
                </Button>
            </Grid>

            <TextBlock Grid.Row="2"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="Bluetoothオーディオを選択" />

            <Border Grid.Row="4"
                    Padding="8"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                     <ListBox x:Name="BluetoothDeviceList"
                              AutomationProperties.Name="ペアリング済みBluetoothオーディオ一覧"
                              AutomationProperties.HelpText="上下矢印でデバイスを選択します"
                              MinHeight="74"
                             MaxHeight="240"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="OnBluetoothSelectionChanged"
                              SelectionMode="Single"
                              SelectedValuePath="DeviceKey">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Margin="2,0,12,0"
                                                 VerticalAlignment="Center"
                                                 Focusable="False"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 IsHitTestVisible="False" />
                                    <Border Grid.Column="1"
                                            Width="40"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource ControlSurfaceBrush}"
                                            CornerRadius="9">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="22"
                                                   Text="{Binding IconGlyph}" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                         <TextBlock FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DisplayName}"
                                                    ToolTip="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="ペアリング済み" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3"
                                               Margin="12,0,2,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding StatusText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="BluetoothEmptyText"
                               Margin="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="ペアリング済みのBluetoothオーディオが見つかりません"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Padding="18"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="音量" />
                    <TextBlock x:Name="VolumePercentText"
                               Grid.Column="2"
                               FontSize="15"
                               Text="--%" />

                    <Slider x:Name="VolumeSlider"
                            AutomationProperties.Name="既定の出力デバイスの音量"
                            AutomationProperties.HelpText="左右矢印で音量を変更します"
                            Grid.Row="2"
                            Grid.Column="0"
                            Minimum="0"
                            Maximum="100"
                            SmallChange="1"
                            LargeChange="5"
                            IsSnapToTickEnabled="True"
                            PreviewKeyUp="OnVolumeKeyUp"
                            PreviewMouseWheel="OnVolumeMouseWheel"
                            Style="{StaticResource QuickPodsSliderStyle}"
                            ValueChanged="OnVolumeChanged"
                            PreviewMouseLeftButtonUp="OnVolumeCommit" />

                    <Button x:Name="MuteButton"
                            Grid.Row="2"
                            Grid.Column="2"
                            AutomationProperties.Name="ミュート切り替え"
                            Click="OnToggleMute"
                            Style="{StaticResource QuickPodsIconButtonStyle}">
                        <TextBlock x:Name="MuteGlyph"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="24"
                                   Text="&#xE767;" />
                    </Button>

                    <TextBlock x:Name="AudioStatusText"
                               AutomationProperties.LiveSetting="Polite"
                               Grid.Row="4"
                               Grid.ColumnSpan="3"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="初期化中" />
                </Grid>
            </Border>

            <Button x:Name="PrimaryActionButton"
                    Grid.Row="8"
                    MinHeight="52"
                    AutomationProperties.Name="Bluetoothオーディオ デバイスを選択"
                    Click="OnPrimaryAction"
                    Style="{StaticResource QuickPodsPrimaryButtonStyle}"
                    Content="デバイスを選択" />

            <StackPanel Grid.Row="10" Orientation="Horizontal">
                <Button x:Name="SoundSettingsButton"
                        AutomationProperties.Name="Windowsのサウンド設定を開く"
                        Click="OnOpenSoundSettings"
                        Style="{StaticResource QuickPodsLinkButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16"
                                   Text="&#xE713;" />
                        <TextBlock FontSize="13" Text="サウンド設定" />
                    </StackPanel>
                </Button>
                <Button Margin="12,0,0,0"
                        AutomationProperties.Name="WindowsのBluetooth設定を開く"
                        Click="OnOpenBluetoothSettings"
                        Style="{StaticResource QuickPodsLinkButtonStyle}">
                    <TextBlock FontSize="13" Text="Bluetooth設定" />
                </Button>
            </StackPanel>

            <Expander Grid.Row="12"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      Header="設定">
                <Border Margin="0,8,0,0"
                        Padding="14"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="タスクバー表示" />
                            <ComboBox x:Name="DisplayModeComboBox"
                                      Grid.Column="1"
                                      AutomationProperties.Name="タスクバー表示モード"
                                      DisplayMemberPath="Text"
                                      SelectedValuePath="Value"
                                      SelectionChanged="OnProductSettingChanged" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="テーマ" />
                            <ComboBox x:Name="ThemeComboBox"
                                      Grid.Column="1"
                                      AutomationProperties.Name="QuickPodsのテーマ"
                                      DisplayMemberPath="Text"
                                      SelectedValuePath="Value"
                                      SelectionChanged="OnProductSettingChanged" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="ホイール刻み" />
                            <ComboBox x:Name="MouseWheelStepComboBox"
                                      Grid.Column="1"
                                      AutomationProperties.Name="音量ホイール変更幅"
                                      DisplayMemberPath="Text"
                                      SelectedValuePath="Value"
                                      SelectionChanged="OnProductSettingChanged" />
                        </Grid>

                        <CheckBox x:Name="SetConnectedDeviceAsDefaultCheckBox"
                                  Margin="0,12,0,0"
                                  AutomationProperties.Name="接続後に既定の音声デバイスへ設定"
                                  Click="OnProductSettingChanged"
                                  Content="接続後に既定の音声デバイスへ設定" />
                        <CheckBox x:Name="ConfirmBluetoothDisconnectCheckBox"
                                  Margin="0,8,0,0"
                                  AutomationProperties.Name="Bluetooth切断前に確認"
                                  Click="OnProductSettingChanged"
                                  Content="Bluetooth切断前に確認" />
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Margin="0,8,0,0"
                                  AutomationProperties.Name="Windowsログイン時にQuickPodsを自動起動"
                                  Checked="OnStartWithWindowsChanged"
                                  Unchecked="OnStartWithWindowsChanged"
                                  Content="Windowsログイン時に自動起動（通知領域）" />

                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                            <Button AutomationProperties.Name="QuickPodsのログフォルダーを開く"
                                    Click="OnOpenLogs"
                                    Style="{StaticResource QuickPodsLinkButtonStyle}"
                                    Content="ログを開く" />
                            <Button Margin="12,0,0,0"
                                    AutomationProperties.Name="QuickPodsの診断情報をクリップボードへコピー"
                                    Click="OnCopyDiagnostics"
                                    Style="{StaticResource QuickPodsLinkButtonStyle}"
                                    Content="診断情報をコピー" />
                        </StackPanel>
                        <TextBlock x:Name="VersionText"
                                   Margin="4,8,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </Expander>

            <StackPanel Grid.Row="14">
                <TextBlock x:Name="SettingsDiagnosticText"
                            AutomationProperties.LiveSetting="Assertive"
                            Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="BluetoothDiagnosticText"
                            AutomationProperties.LiveSetting="Assertive"
                            Margin="0,4,0,0"
                            Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="AudioDiagnosticText"
                            AutomationProperties.LiveSetting="Assertive"
                            Margin="0,4,0,0"
                            Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
