<Window x:Class="QuickPods.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPods"
        Width="402"
        MinWidth="402"
        MaxWidth="402"
        MaxHeight="760"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        Foreground="{DynamicResource PrimaryTextBrush}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnLoaded"
        ContentRendered="OnContentRendered"
        MouseEnter="OnFlyoutMouseEnter"
        MouseLeave="OnFlyoutMouseLeave"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Closing="OnClosing"
        Closed="OnClosed">
    <Window.Resources>
        <Style x:Key="QuickPodsDiagnosticTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                MinHeight="64"
                                Padding="11,8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="RowBorder" Property="BorderThickness" Value="1" />
                                <Setter TargetName="RowBorder" Property="CornerRadius" Value="9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="FlyoutSurface"
            Margin="10,10,10,4"
            Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.52"
                              ShadowDepth="5"
                              Color="#000000" />
        </Border.Effect>

        <ScrollViewer MaxHeight="720"
                      VerticalContentAlignment="Top"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="18,16,18,15"
                  VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="21"
                                   FontWeight="SemiBold"
                                   Text="オーディオ" />
                        <TextBlock x:Name="EndpointNameText"
                                   Visibility="Collapsed"
                                   Text="既定の出力を確認しています…" />
                    </StackPanel>
                    <Button x:Name="RefreshButton"
                            Grid.Column="1"
                            AutomationProperties.Name="オーディオとBluetoothデバイスを更新"
                            Click="OnRefresh"
                            Style="{StaticResource QuickPodsHeaderIconButtonStyle}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="19"
                                   Text="&#xE72C;" />
                    </Button>
                </Grid>

                <TextBlock x:Name="BluetoothSectionTitle"
                           Grid.Row="2"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="Bluetoothオーディオを選択" />

                <Border Grid.Row="4"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        ClipToBounds="True">
                    <Grid>
                        <ListBox x:Name="BluetoothDeviceList"
                                 AutomationProperties.Name="ペアリング済みBluetoothオーディオ一覧"
                                 AutomationProperties.HelpText="上下矢印でデバイスを選択します"
                                 MaxHeight="230"
                                 Padding="0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="OnBluetoothSelectionChanged"
                                 SelectionMode="Single"
                                 SelectedValuePath="DeviceKey">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <RadioButton Margin="1,0,11,0"
                                                     VerticalAlignment="Center"
                                                     IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                                                     IsHitTestVisible="False"
                                                     Style="{StaticResource QuickPodsRadioButtonStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Width="37"
                                                   Margin="0,0,10,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="27"
                                                   Text="{Binding IconGlyph}" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       ToolTip="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="ペアリング済み" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3"
                                                   MaxWidth="100"
                                                   Margin="8,0,2,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Text="{Binding StatusText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid x:Name="BluetoothEmptyState" MinHeight="174" Margin="12">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Grid Width="58" Height="52" HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="42"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="&#xE7F6;" />
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,1,1"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="20"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="&#xE702;" />
                                </Grid>
                                <TextBlock x:Name="BluetoothEmptyText"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="デバイスが見つかりません"
                                           TextAlignment="Center" />
                                <TextBlock x:Name="BluetoothEmptyDescriptionText"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="ペアリング済みのBluetoothオーディオがありません"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Button x:Name="EmptyRefreshButton"
                                        Margin="0,13,0,0"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.Name="Bluetoothオーディオを再検索"
                                        Click="OnRefresh"
                                        Style="{StaticResource QuickPodsSecondaryButtonStyle}"
                                        Content="再検索" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="6"
                        Margin="-18,0,-18,0"
                        Padding="18,16,18,0"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="13" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>

                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="音量" />
                        <TextBlock x:Name="VolumePercentText"
                                   Grid.Column="2"
                                   HorizontalAlignment="Center"
                                   FontSize="15"
                                   Text="--%" />

                        <Slider x:Name="VolumeSlider"
                                Grid.Row="2"
                                AutomationProperties.Name="既定の出力デバイスの音量"
                                AutomationProperties.HelpText="左右矢印で音量を変更します"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="1"
                                LargeChange="5"
                                IsSnapToTickEnabled="True"
                                PreviewKeyUp="OnVolumeKeyUp"
                                PreviewMouseWheel="OnVolumeMouseWheel"
                                Style="{StaticResource QuickPodsSliderStyle}"
                                ValueChanged="OnVolumeChanged"
                                PreviewMouseLeftButtonUp="OnVolumeCommit" />

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <Button x:Name="MuteButton"
                                    Width="52"
                                    Height="52"
                                    AutomationProperties.Name="ミュート切り替え"
                                    Click="OnToggleMute"
                                    Style="{StaticResource QuickPodsIconButtonStyle}">
                                <TextBlock x:Name="MuteGlyph"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="23"
                                           Text="&#xE767;" />
                            </Button>
                            <TextBlock x:Name="AudioStatusText"
                                       AutomationProperties.LiveSetting="Polite"
                                       Margin="-20,6,-20,0"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="初期化中"
                                       TextAlignment="Center"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="PrimaryActionButton"
                        Grid.Row="8"
                        MinHeight="48"
                        AutomationProperties.Name="Bluetoothオーディオ デバイスを選択"
                        Click="OnPrimaryAction"
                        Style="{StaticResource QuickPodsPrimaryButtonStyle}"
                        Content="接続" />

                <Grid Grid.Row="10">
                    <Button x:Name="SoundSettingsButton"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Windowsのサウンド設定を開く"
                            Click="OnOpenSoundSettings"
                            Style="{StaticResource QuickPodsLinkButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="17"
                                       Text="&#xE713;" />
                            <TextBlock FontSize="13" Text="サウンド設定を開く" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BluetoothSettingsButton"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="WindowsのBluetooth設定を開く"
                            Click="OnOpenBluetoothSettings"
                            Style="{StaticResource QuickPodsLinkButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="17"
                                       Text="&#xE713;" />
                            <TextBlock FontSize="13" Text="Bluetooth設定を開く" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Expander x:Name="SettingsExpander"
                          Grid.Row="12"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          Header="QuickPods設定">
                    <Border Margin="0,8,0,0"
                            Padding="12"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="タスクバー表示" />
                                <ComboBox x:Name="DisplayModeComboBox"
                                          Grid.Column="1"
                                          AutomationProperties.Name="タスクバー表示モード"
                                          DisplayMemberPath="Text"
                                          SelectedValuePath="Value"
                                          SelectionChanged="OnProductSettingChanged" />
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="テーマ" />
                                <ComboBox x:Name="ThemeComboBox"
                                          Grid.Column="1"
                                          AutomationProperties.Name="QuickPodsのテーマ"
                                          DisplayMemberPath="Text"
                                          SelectedValuePath="Value"
                                          SelectionChanged="OnProductSettingChanged" />
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="ホイール刻み" />
                                <ComboBox x:Name="MouseWheelStepComboBox"
                                          Grid.Column="1"
                                          AutomationProperties.Name="音量ホイール変更幅"
                                          DisplayMemberPath="Text"
                                          SelectedValuePath="Value"
                                          SelectionChanged="OnProductSettingChanged" />
                            </Grid>
                            <CheckBox x:Name="SetConnectedDeviceAsDefaultCheckBox"
                                      Margin="0,11,0,0"
                                      AutomationProperties.Name="接続後に既定の音声デバイスへ設定"
                                      Click="OnProductSettingChanged"
                                      Content="接続後に既定の音声デバイスへ設定" />
                            <CheckBox x:Name="ConfirmBluetoothDisconnectCheckBox"
                                      Margin="0,7,0,0"
                                      AutomationProperties.Name="Bluetooth切断前に確認"
                                      Click="OnProductSettingChanged"
                                      Content="Bluetooth切断前に確認" />
                            <CheckBox x:Name="StartWithWindowsCheckBox"
                                      Margin="0,7,0,0"
                                      AutomationProperties.Name="Windowsログイン時にQuickPodsを自動起動"
                                      Checked="OnStartWithWindowsChanged"
                                      Unchecked="OnStartWithWindowsChanged"
                                      Content="Windowsログイン時に自動起動" />
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button AutomationProperties.Name="QuickPodsのログフォルダーを開く"
                                        Click="OnOpenLogs"
                                        Style="{StaticResource QuickPodsLinkButtonStyle}"
                                        Content="ログを開く" />
                                <Button Margin="10,0,0,0"
                                        AutomationProperties.Name="QuickPodsの診断情報をクリップボードへコピー"
                                        Click="OnCopyDiagnostics"
                                        Style="{StaticResource QuickPodsLinkButtonStyle}"
                                        Content="診断情報をコピー" />
                            </StackPanel>
                            <TextBlock x:Name="VersionText"
                                       Margin="4,7,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </Expander>

                <StackPanel Grid.Row="14">
                    <TextBlock x:Name="SettingsDiagnosticText"
                               AutomationProperties.LiveSetting="Assertive"
                               Foreground="{DynamicResource ErrorBrush}"
                               Style="{StaticResource QuickPodsDiagnosticTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="BluetoothDiagnosticText"
                               AutomationProperties.LiveSetting="Assertive"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource ErrorBrush}"
                               Style="{StaticResource QuickPodsDiagnosticTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="AudioDiagnosticText"
                               AutomationProperties.LiveSetting="Assertive"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource ErrorBrush}"
                               Style="{StaticResource QuickPodsDiagnosticTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>
